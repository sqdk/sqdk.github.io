---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.png';

// Logo Imports
import complexioLogo from '../assets/complexio_logo.png';
import dixaLogo from '../assets/dixa_logo.png';
import nordicLogo from '../assets/nordic_api_gateway_logo.png';
import unityLogo from '../assets/unity_logo.png';
import trustpilotLogo from '../assets/trustpilo_logo.png';

const skillGroups = [
	{ name: "Languages", items: ["Go", "TypeScript", "Python", "C#", "F#"] },
	{ name: "Platform", items: ["Kubernetes (EKS)", "AWS", "Azure", "Pulumi", "Terraform", "CI/CD"] },
	{ name: "Practices", items: ["Platform engineering", "Developer experience", "Security by design", "Identity & access management (IAM)", "Compliance", "Incident management"] },
];
---

<Layout
	title="Christian Probst | Staff Platform Engineer"
	description="Staff Platform Engineer. Infrastructure software in Go & TypeScript · Kubernetes · AWS. Copenhagen, Denmark."
>
	<main class="max-w-4xl mx-auto px-4 py-24">
		<header class="mb-16">
			<div class="flex flex-col md:flex-row justify-between items-start gap-8">
				<div class="flex items-center gap-6 flex-1">
					<div class="w-24 h-24 md:w-32 md:h-32 flex-shrink-0 rounded-full overflow-hidden border-2 border-accent opacity-0 animate-fade-in shadow-[0_0_15px_rgba(0,242,234,0.3)]">
						<Image
							src={headshot}
							alt="Christian Probst"
							width={256}
							height={256}
							class="w-full h-full object-cover"
						/>
					</div>
					<div>
						<h1 class="text-4xl md:text-6xl font-bold text-accent opacity-0 animate-reveal-up signature mb-2 leading-tight whitespace-nowrap">
							Christian Probst
						</h1>
						<p class="text-xl md:text-2xl text-white/80 opacity-0 animate-fade-in whitespace-nowrap">Staff Platform Engineer</p>
						<div class="opacity-0 animate-fade-in mt-2 space-y-2">
							<p class="text-white/60">Infrastructure software in Go &amp; TypeScript · Kubernetes · AWS | Copenhagen, Denmark</p>
							<div class="flex flex-wrap gap-4 text-sm text-gray-400">
								<a href="mailto:christian.probst.dk@gmail.com" class="flex items-center gap-2 hover:text-accent transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
									christian.probst.dk@gmail.com
								</a>
								<a href="https://github.com/sqdk" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-accent transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
									github.com/sqdk
								</a>
								<a href="https://www.linkedin.com/in/cprobstdk" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-accent transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
									linkedin.com/in/cprobstdk
								</a>
							</div>
						</div>
					</div>
				</div>
				<button
					onclick="window.print()"
					class="p-2 border border-accent text-accent hover:bg-accent hover:text-black transition-colors rounded-sm no-print opacity-0 animate-fade-in mt-2 flex items-center justify-center"
					aria-label="Print Resume"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="6 9 6 2 18 2 18 9"></polyline>
						<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
						<rect x="6" y="14" width="12" height="8"></rect>
					</svg>
				</button>
			</div>
			<div class="w-full h-px bg-white/20 mt-8 opacity-0 animate-fade-in"></div>
		</header>

		<div class="space-y-16 opacity-0 animate-fade-in">
			<section>
				<h2 class="text-2xl font-bold border-b border-gray-800 pb-2 mb-6 uppercase tracking-wider text-accent">Summary</h2>
				<div class="text-gray-300 leading-relaxed text-lg space-y-4">
					<p>
						I'm a platform engineer who started as a software engineer and never stopped writing code.
						I've built microservices in Go, C# and Python, developer tooling in F# and TypeScript, and
						infrastructure platforms on AWS, Azure and Kubernetes, mostly at Copenhagen startups and
						scaleups, several of which went on to IPO.
					</p>
					<p>
						My focus is building platforms engineers actually want to use: self-service tooling, CLIs and
						APIs that replace tickets and tribal knowledge, and infrastructure designed for where the
						company is heading. At Dixa I was hired to turn a scrappy startup platform into a fully
						codified, self-service one for 60 engineers, and built SOC 2 compliance into it by design.
						At Complexio, as the first infrastructure hire, I built the foundation for on-premise
						deployments of a distributed AI system, from VMs to Kubernetes.
					</p>
					<p>
						As a staff engineer and technical lead, I set technical direction across teams, drive
						architectural decisions, and lead through influence rather than authority. I stay hands-on
						because the best technical decisions come from people who still write the code.
					</p>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold border-b border-gray-800 pb-2 mb-6 uppercase tracking-wider text-accent">Skills</h2>
				<div class="space-y-6">
					{skillGroups.map((group) => (
						<div class="print-avoid-break">
							<h4 class="font-bold text-white mb-3">{group.name}</h4>
							<div class="flex flex-wrap gap-2">
								{group.items.map((skill) => (
									<span class="px-3 py-1 border border-gray-700 rounded-full text-sm text-gray-300 hover:border-accent hover:text-accent transition-colors cursor-default">
										{skill}
									</span>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold border-b border-gray-800 pb-2 mb-8 uppercase tracking-wider text-accent">Experience</h2>
				<div class="space-y-12">
					<!-- Complexio -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden">
								<Image src={complexioLogo} alt="Complexio Logo" class="w-full h-full object-contain" />
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">Complexio</h3>
									<span class="text-gray-500">April 2024 — Present</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">Senior DevOps Engineer</p>
								<p class="text-gray-500 text-sm mb-3">Apr 2024 — Present</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Technical lead for the infrastructure group (7 engineers), owning on-premise deployments of a distributed AI application.</li>
									<li>Led the transition from VMs to managed AKS, shaping the platform around the commercial, security and compliance requirements of large enterprise customers who strictly limit how much access the vendor has.</li>
									<li>Built a multi-stack Pulumi platform in TypeScript on the Pulumi Automation API, with no CLI needed and security built in: Entra federated access, scope isolation, high-privilege stacks kept apart from the rest, and isolated per-customer stacks.</li>
									<li>Built a TypeScript wrapper for defining Ansible playbooks and inventories in code, enforcing a standard structure across deployments.</li>
									<li>Designed just-in-time privileged access with Entra PIM, covering both customer environments and the company's own systems and data, with access requests and renewals as GitHub pull requests so git is the audit log. Built a CLI that lets engineers activate PIM group permissions without leaving the terminal, released once the API supported activating PIM for Groups.</li>
									<li>Designed the product's authorization system on Entra ID OAuth and fixed issues in existing OAuth implementations. Took on large-scale, AI-assisted refactors of how applications source configuration, because it was a constant source of friction.</li>
									<li>First infrastructure hire (#9 employee); built the company's security and compliance foundations alongside product infrastructure, including a least-privilege Entra ID directory with role- and title-based access grants, and Intune device restrictions for critical systems such as GitHub and Tailscale.</li>
									<li>Trusted technical contact for several of the early customers I helped onboard, often short-circuiting communication and greatly cutting turnaround on changes that needed customer involvement.</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Dixa -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden">
								<Image src={dixaLogo} alt="Dixa Logo" class="w-full h-full object-contain" />
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">Dixa</h3>
									<span class="text-gray-500">August 2020 — April 2024</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">Staff Engineer, Platform Engineering</p>
								<p class="text-gray-500 text-sm mb-3">Oct 2022 — Apr 2024</p>
								<p class="text-gray-400 mb-3">Owned the technical direction of Dixa's infrastructure platform, serving 60 engineers.</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Built SOC 2 readiness into the platform ahead of the audit: least-privilege access, time-limited elevated access, no shared accounts, and a reliable audit trail across both AWS and the Pulumi platform, so compliance was part of the platform's design rather than a scramble at audit time.</li>
									<li>Evolved the provisioning platform into the standard path for all services, with security, compliance and observability built in by default.</li>
									<li>Set org-wide engineering standards for PR, deployment and code practices.</li>
									<li>Mentored engineers through technical 1:1s and mob/pair programming.</li>
								</ul>
							</div>
							<div class="role">
								<p class="text-accent text-lg">Lead Platform Engineer</p>
								<p class="text-gray-500 text-sm mb-3">Apr 2021 — Oct 2022</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Technical lead of the platform team: set the platform's long-term direction and defined ways of working, from architecture discussions to PR and deployment processes.</li>
									<li>Built an in-cluster web app that let developers deploy with appropriate guardrails, or automate deployments from CI using our managed CI templates.</li>
									<li>Drove adoption of the platform's self-service tooling across engineering.</li>
								</ul>
							</div>
							<div class="role">
								<p class="text-accent text-lg">Senior Platform Engineer</p>
								<p class="text-gray-500 text-sm mb-3">Aug 2020 — Apr 2021</p>
								<p class="text-gray-400 mb-3">Hired to replace Dixa's early, hand-built infrastructure with a platform that could scale.</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Designed and built a fully codified, automated platform for microservice provisioning on AWS EKS, replacing local tooling that pushed straight to an unprotected main branch, which many developers didn't feel confident using.</li>
									<li>Designed the platform so each service lived in its own stack: teams could raise and review PRs for their own services without the platform team, every change had a limited blast radius, and credentials came out of git. Built inter-stack dependency tracking in-house, similar to what Spacelift offers, so platform-level changes showed exactly which downstream services they would affect.</li>
									<li>Led the cross-team migration of all product teams onto the new platform within my first six months, upskilling teams to work independently from off-the-shelf templates and working through disagreements over conventions carried over from the previous setup.</li>
									<li>Built the platform's developer interface (CLI tools, APIs and web apps in TypeScript), making "you build it, you own it" practical for 60 engineers.</li>
									<li>Architected the new microservice platform for 10–100x the previous load, entirely as infrastructure-as-code in Pulumi (TypeScript).</li>
								</ul>
								<p class="text-gray-500 text-sm mt-3">Stack: TypeScript · Kubernetes (EKS) · AWS · Pulumi</p>
							</div>
						</div>
					</div>

					<!-- Nordic API Gateway -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden">
								<Image src={nordicLogo} alt="Nordic API Gateway Logo" class="w-full h-full object-contain" />
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">Aiia (Formerly Nordic API Gateway)</h3>
									<span class="text-gray-500">May 2019 — August 2020</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">DevOps Tech Lead</p>
								<p class="text-gray-500 text-sm mb-3">May 2019 — Aug 2020</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Lead for the DevOps team responsible for IaC automation and optimizing software development processes.</li>
									<li>Architected and implemented a microservice foundation in Azure.</li>
									<li>Introduced Terraform with a focus on developer usability.</li>
									<li>Built a scalable system for calculating microservice uptime stored in a custom data warehouse.</li>
								</ul>
								<p class="text-gray-500 text-sm mt-3">Stack: Azure · Kubernetes · TypeScript · C# · Terraform · Azure Functions · Grafana</p>
							</div>
						</div>
					</div>

					<!-- Unity -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden">
								<Image src={unityLogo} alt="Unity Logo" class="w-full h-full object-contain" />
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">Unity Technologies</h3>
									<span class="text-gray-500">Oct 2017 — Apr 2019</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">Software Developer</p>
								<p class="text-gray-500 text-sm mb-3">Oct 2017 — Apr 2019</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Software development in F#, Python and JavaScript (Node.js).</li>
									<li>Development and maintenance of developer tooling and deployment automation.</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Trustpilot -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden">
								<Image src={trustpilotLogo} alt="Trustpilot Logo" class="w-full h-full object-contain" />
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">Trustpilot</h3>
									<span class="text-gray-500">Sep 2015 — Sep 2017</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">Full Stack Developer</p>
								<p class="text-gray-500 text-sm mb-3">Sep 2015 — Sep 2017</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Built microservices in Go, C#, Python and JavaScript on AWS (Lambda, SQS, SNS, Kinesis, API Gateway, DynamoDB, ECS).</li>
									<li>Owned build, deployment and tooling infrastructure; proposed tooling and architecture best practices adopted by other teams.</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- ABC Softwork -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden flex items-center justify-center" aria-hidden="true">
								<span class="text-black text-xs font-bold">ABC</span>
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">ABC Softwork</h3>
									<span class="text-gray-500">Jan 2014 — Aug 2015</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">DevOps Engineer</p>
								<p class="text-gray-500 text-sm mb-3">Jan 2014 — Aug 2015</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Development and maintenance of full-stack web apps in Go and AngularJS.</li>
									<li>REST API development (Go).</li>
									<li>Infrastructure development and maintenance (Rackspace).</li>
									<li>Continuous integration and deployment (Chef, Jenkins).</li>
									<li>Log centralization and analysis; introduced monitoring and alerting.</li>
									<li>Managed daily internal and external technical and application support.</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- SAS -->
					<div class="hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300 group">
						<div class="entry-header flex items-start gap-4 mb-4">
							<div class="w-12 h-12 flex-shrink-0 bg-white p-1 rounded overflow-hidden flex items-center justify-center" aria-hidden="true">
								<span class="text-black text-xs font-bold">SAS</span>
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-baseline mb-1">
									<h3 class="text-2xl font-bold">SAS</h3>
									<span class="text-gray-500">2011 — 2014</span>
								</div>
							</div>
						</div>

						<div class="ml-16 space-y-6">
							<div class="role">
								<p class="text-accent text-lg">Student Employee</p>
								<p class="text-gray-500 text-sm mb-3">2011 — 2014</p>
								<ul class="list-disc list-outside ml-4 text-gray-400 space-y-2">
									<li>Ad-hoc development of software tools in C# and Python.</li>
									<li>1st and 2nd level support for in-house employees.</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold border-b border-gray-800 pb-2 mb-6 uppercase tracking-wider text-accent">Languages</h2>
				<div class="space-y-2 text-gray-300">
					<p><span class="font-bold text-white">Danish:</span> Native or Bilingual</p>
					<p><span class="font-bold text-white">English:</span> Native or Bilingual</p>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold border-b border-gray-800 pb-2 mb-6 uppercase tracking-wider text-accent">Education</h2>
				<div class="space-y-6">
					<div class="print-avoid-break hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300">
						<div class="flex justify-between items-baseline mb-1">
							<h3 class="text-xl font-bold">Danmarks Tekniske Universitet</h3>
							<span class="text-gray-500">2010 — 2014</span>
						</div>
						<p class="text-gray-400">Bachelor of Applied Science - BASc, IT Engineering</p>
					</div>
					<div class="print-avoid-break hover:bg-white/5 p-4 -mx-4 rounded-lg transition-colors duration-300">
						<div class="flex justify-between items-baseline mb-1">
							<h3 class="text-xl font-bold">CPHWest Ishøj</h3>
							<span class="text-gray-500">2006 — 2009</span>
						</div>
						<p class="text-gray-400">HTX, Math, physics and programming</p>
					</div>
				</div>
			</section>
		</div>

		<footer class="mt-24 pt-8 border-t border-gray-800 text-gray-500 text-sm flex justify-between items-center no-print">
			<p>&copy; 2025 Christian Probst</p>
		</footer>
	</main>
</Layout>

<style>
	.signature {
		display: inline-block;
	}

	@keyframes reveal-up {
		0% {
			opacity: 0;
			transform: translateY(20px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fade-in {
		0% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	.animate-reveal-up {
		animation: reveal-up 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
	}

	.animate-fade-in {
		animation: fade-in 1s ease-out forwards;
	}

	@media print {
		.no-print {
			display: none;
		}
		body {
			background-color: white !important;
			color: black !important;
		}
		.text-gray-300, .text-gray-400, .text-gray-500 {
			color: #374151 !important;
		}
		.text-accent {
			color: black !important;
			font-weight: bold;
		}
		.border-gray-800 {
			border-color: #e5e7eb !important;
		}
		.animate-reveal-up, .animate-fade-in {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
		.rounded-full {
			border-color: black !important;
			box-shadow: none !important;
		}
		main {
			padding-top: 0 !important;
			padding-bottom: 0 !important;
			max-width: none !important;
		}
		/* Ensure hover effects are off in print */
		.hover\:bg-white\/5 {
			background-color: transparent !important;
		}
		/* Print skill pills borders nicely */
