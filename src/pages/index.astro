---
import Layout from '../layouts/Layout.astro';

const links = [
	{ href: '/resume/', label: 'Resume' },
	{ href: '/experiments/', label: 'Experiments' },
];
---

<Layout
	title="Christian Probst"
	description="Christian Probst, Staff Platform Engineer in Copenhagen. Resume and experiments."
>
	<Fragment slot="head">
		<!--
			Decide before first paint whether to play the splash, so the title never flashes.
			It plays on fresh visits and reloads, not when coming back from another page on the site.
		-->
		<script is:inline>
			(function () {
				try {
					var nav = performance.getEntriesByType('navigation')[0];
					var type = nav ? nav.type : 'navigate';
					var internal = document.referrer && new URL(document.referrer).origin === location.origin;
					var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
					if (still || type === 'back_forward' || (internal && type !== 'reload')) return;
					document.documentElement.classList.add('splash');
				} catch (e) {}
			})();
		</script>
	</Fragment>

	<canvas id="beads" class="beads" aria-hidden="true"></canvas>
	<div class="scrim" aria-hidden="true"></div>

	<main class="home">
		<h1 class="rise" style="--i:0">Christian Probst</h1>
		<p class="tag rise" style="--i:1">Staff Platform Engineer · Copenhagen</p>
		<nav class="menu" aria-label="Main">
			{
				links.map((link, i) => (
					<a href={link.href} class="rise" style={`--i:${i + 2}`}>
						<span class="num">{String(i + 1).padStart(2, '0')}</span>
						<span class="label">{link.label}</span>
						<span class="arrow" aria-hidden="true">→</span>
					</a>
				))
			}
		</nav>
	</main>
</Layout>

<script>
	import { createBeads } from '../home/beads';

	const html = document.documentElement;
	const canvas = document.getElementById('beads') as HTMLCanvasElement;
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const coarse = matchMedia('(pointer: coarse)').matches;

	const SPLASH_MS = 1500; // full-brightness part; the hand-over to the title adds ~0.7 s
	const MIN_PIXELS = 120_000;
	let budget = coarse ? 800_000 : 2_000_000;
	const beads = createBeads(canvas, budget);

	let splash = html.classList.contains('splash');
	const endSplash = () => {
		if (!splash) return;
		splash = false;
		html.classList.remove('splash');
		removeEventListener('pointerdown', endSplash);
		removeEventListener('keydown', endSplash);
	};

	const ease = (x: number) => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
	// Scene time as a function of real time: sweeps fast during the splash, then settles into a slow drift.
	const SWEEP_MS = 2600;
	const sceneTime = (ms: number) => {
		const u = Math.min(ms / SWEEP_MS, 1);
		return ms / 1000 + ((12 * SWEEP_MS) / 1000) * ((1 - Math.pow(1 - u, 4)) / 4);
	};
	const grow = (ms: number) => ease(ms / 700);

	// Dev only: ?at=<ms> renders the frame at that moment of the timeline, for screenshots.
	const at = import.meta.env.DEV ? new URLSearchParams(location.search).get('at') : null;

	if (!beads) {
		// No WebGL: plain black title page.
		canvas.remove();
		endSplash();
	} else if (at !== null) {
		const ms = Number(at);
		beads.render(100 + sceneTime(ms), grow(ms));
		html.classList.add('live');
		if (ms > SPLASH_MS) endSplash();
		(window as any).__done = true;
	} else {
		// Start somewhere different on every visit.
		const seed = Math.random() * 900;
		if (still) {
			beads.render(seed, 1);
			html.classList.add('live');
			endSplash();
		} else {
			addEventListener('pointerdown', endSplash);
			addEventListener('keydown', endSplash);
			addEventListener('resize', () => beads.resize());

			// The timeline starts at the first drawn frame, not at page load.
			let start = 0;
			let lastDraw = 0;
			let slow = 0;
			let frames = 0;

			const frame = (now: number) => {
				requestAnimationFrame(frame);
				if (!start) start = now;
				const elapsed = now - start;
				if (splash && elapsed > SPLASH_MS) endSplash();

				// Once it is only a backdrop, 30 fps is plenty and much kinder to batteries.
				const gap = now - lastDraw;
				if (!splash && gap < 30) return;
				if (!lastDraw) html.classList.add('live');
				lastDraw = now;

				// If the GPU can't keep up, render fewer pixels rather than drop frames.
				// (The first frames include shader compilation, so they don't count.)
				// Resizing clears the canvas, so this has to happen before drawing.
				const target = splash ? 17 : 34;
				if (++frames > 3) slow = gap > target * 1.6 ? slow + 1 : Math.max(slow - 1, 0);
				if (slow >= 4 && budget > MIN_PIXELS) {
					const cut = Math.min(Math.max((target / gap) * 1.2, 0.3), 0.7);
					budget = Math.max(budget * cut, MIN_PIXELS);
					beads.setBudget(budget);
					slow = 0;
				}

				beads.render(seed + sceneTime(elapsed), grow(elapsed));
			};
			requestAnimationFrame(frame);
		}
	}
</script>

<style>
	.beads {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.8s ease;
	}
	:global(html.live) .beads {
		opacity: 0.5;
	}
	:global(html.splash) .beads {
		opacity: 1;
		transition-duration: 0.2s;
		cursor: pointer;
	}

	/* Darkens the area the text sits in so it stays readable over the beads. */
	.scrim {
		position: fixed;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(to top, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.62) 30%, rgb(0 0 0 / 0) 64%);
		transition: opacity 0.8s ease;
	}
	@media (min-width: 768px) {
		.scrim {
			background: radial-gradient(110% 120% at 0% 100%, rgb(0 0 0 / 0.92) 0%, rgb(0 0 0 / 0.7) 40%, rgb(0 0 0 / 0) 78%);
		}
	}
	:global(html.splash) .scrim {
		opacity: 0;
		transition-duration: 0.2s;
	}

	.home {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: clamp(1.5rem, 6vw, 5rem);
		padding-bottom: max(clamp(2rem, 7vw, 5rem), env(safe-area-inset-bottom));
	}

	h1 {
		font-size: clamp(2.75rem, 10.5vw, 7rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.tag {
		margin-top: clamp(0.75rem, 2vw, 1.25rem);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(0.8125rem, 1.6vw, 0.9375rem);
		color: rgb(255 255 255 / 0.6);
	}

	.menu {
		margin-top: clamp(2rem, 6vw, 3.5rem);
		display: flex;
		flex-direction: column;
		max-width: 34rem;
		border-top: 1px solid rgb(255 255 255 / 0.18);
	}
	.menu a {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: clamp(0.9rem, 2.4vw, 1.15rem) 0;
		border-bottom: 1px solid rgb(255 255 255 / 0.18);
		font-size: clamp(1.5rem, 4.6vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		-webkit-tap-highlight-color: transparent;
	}
	.num {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.8125rem;
		font-weight: 400;
		letter-spacing: 0;
		color: var(--accent);
	}
	.label {
		flex: 1;
		transition: color 0.12s;
	}
	.arrow {
		color: rgb(255 255 255 / 0.4);
		transition:
			transform 0.12s,
			color 0.12s;
	}
	.menu a:hover .label,
	.menu a:hover .arrow,
	.menu a:focus-visible .label,
	.menu a:focus-visible .arrow {
		color: var(--accent);
	}
	.menu a:hover .arrow,
	.menu a:focus-visible .arrow {
		transform: translateX(6px);
	}
	.menu a:active .label {
		color: var(--accent);
	}

	/* Splash hand-over: the title and links rise in one after another. */
	.rise {
		transition:
			opacity 0.55s ease,
			transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
			color 0.12s;
		transition-delay: calc(var(--i) * 70ms), calc(var(--i) * 70ms), 0s;
	}
	:global(html.splash) .rise {
		opacity: 0;
		transform: translateY(14px);
		transition: none;
	}
	:global(html.splash) .home {
		pointer-events: none;
		/* If the script never runs, show the page anyway. */
		animation: failsafe 0.01s 4s forwards;
	}
	@keyframes failsafe {
		to {
			pointer-events: auto;
		}
	}
	:global(html.splash) .home .rise {
		animation: failsafe-rise 0.4s 4s forwards;
	}
	@keyframes failsafe-rise {
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
